# Postgres — en local (docker-compose) ou l'URL Neon en production.
DATABASE_URL="postgresql://mcp:mcp_dev_password@localhost:5433/mimicherryprivate?schema=public"

# Port d'écoute de l'API
PORT=4000

# Origines autorisées pour le CORS (front client + front admin), séparées par des virgules
CORS_ORIGIN="http://localhost:8080,http://localhost:8081"

# Secrets JWT — à régénérer en production (ex: openssl rand -hex 64)
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# URLs des deux front-ends — utilisées pour construire les liens dans les e-mails
CLIENT_APP_URL="http://localhost:8080"
ADMIN_APP_URL="http://localhost:8081"

# E-mails transactionnels (Brevo) — laisser BREVO_API_KEY vide en dev :
# le service journalise un avertissement et n'envoie rien, sans bloquer l'app.
BREVO_API_KEY=""
MAIL_FROM="no-reply@mimicherryprivate.com"
MAIL_FROM_NAME="Mimi Cherry Private"
ADMIN_EMAIL=""

# Stockage des images produits (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
